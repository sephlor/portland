{
    "name": "pylibfreenect2",
    "build": {
        "context": "${localWorkspaceFolder}/.devcontainer",
        "dockerfile": "${localWorkspaceFolder}/.devcontainer/Dockerfile",
        "args": {
           "BASE": "ubuntu:24.04"
        }
    },
    "runArgs": [
        "--name", "python",
        "--device-cgroup-rule=c 189:* rmw"
    ],
    "hostRequirements": {
        "gpu": "optional"
    },
    "remoteUser": "coder",
    "containerUser": "root",
    "updateRemoteUserUID": true,
    "containerEnv": {
        "LANG": "${localEnv:LANG:en_US.UTF-8}",
        "TERM": "${localEnv:TERM:linux}",
        "DISPLAY": "${localEnv:DISPLAY}",
        "NVCUDASAMPLES_ROOT": "/home/coder/portland/libfreenect2/cuda-samples"
    },
    "workspaceFolder": "/home/coder/portland",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/coder/portland,type=bind",
    "mounts": [
        "source=${localWorkspaceFolder}/venvs/,target=/home/coder/.local/share/venvs,type=bind",
        "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"

    ],
    "initializeCommand": [
        "/bin/bash", "-c", "mkdir -p ${localWorkspaceFolder}/venvs/"
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "userUid": "1001",
            "userGid": "1001",
            "username": "coder",
            "installZsh": "false",
            "upgradePackages": "true"
        },
        "ghcr.io/devcontainers/features/git:1": {
            "ppa": "true",
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/git-lfs:1.2.1": {
            "autoPull": false
        },
        "ghcr.io/devcontainers/features/github-cli:1.1.0": {},
        "ghcr.io/rapidsai/devcontainers/features/llvm:latest": {
            "version": "23"
        },
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/rapidsai/devcontainers/features/cuda:26": {
            "installOpenCL": true
        },
        "ghcr.io/rapidsai/devcontainers/features/cmake:26": {},
        "ghcr.io/rapidsai/devcontainers/features/ninja:26": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/devcontainers/features/git",
        "ghcr.io/devcontainers/features/git-lfs",
        "ghcr.io/devcontainers/features/github-cli",
        "ghcr.io/rapidsai/devcontainers/features/llvm",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/rapidsai/devcontainers/features/cuda",
        "ghcr.io/rapidsai/devcontainers/features/cmake",
        "ghcr.io/rapidsai/devcontainers/features/ninja",
        "ghcr.io/anthropics/devcontainer-features/claude-code"
    ]
}
